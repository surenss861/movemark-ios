// 1. Copy this file to Secrets.xcconfig (same folder).
// 2. Fill in the Neon endpoints for the branch this build talks to (dev builds: the `dev` branch).
// Secrets.xcconfig is gitignored — never commit it. Nothing here is a secret credential: the app holds no
// database or storage keys, only public endpoints; users authenticate with Neon Auth.
//
// IMPORTANT: a raw `https://...` line is truncated at `//` (xcconfig comment).
// Use: https:/$()/$(/)host/path

// Neon Auth base for the branch (Neon console → Auth).
NEON_AUTH_URL = https:/$()/$(/)ep-YOUR-ENDPOINT.neonauth.c-7.us-east-2.aws.neon.tech/neondb/auth
// Neon Data API for the branch (Neon console → Data API).
NEON_DATA_API_URL = https:/$()/$(/)ep-YOUR-ENDPOINT.apirest.c-7.us-east-2.aws.neon.tech/neondb/rest/v1

// HTTPS password-reset page (production: the reset domain, with the app's Associated Domains entitlement).
// Empty: Neon Auth's default reset link and the movemark:// scheme.
// MOVEMARK_PASSWORD_RESET_URL = https:/$()/$(/)auth.YOUR-DOMAIN/reset

// Optional: point a non-production build at another MoveMark API (e.g. one running on this Mac for the
// simulator). Empty = the target's MoveMarkAPIBaseURL build setting.
// MOVEMARK_API_BASE_URL_OVERRIDE = http:/$()/$(/)127.0.0.1:8787

// Optional — Debug only. RevenueCat Test Store public SDK key (test_…). Release/TestFlight ignores this;
// use appl_… via Xcode target REVENUECAT_APP_STORE_PUBLIC_KEY for archives.
// REVENUECAT_TEST_STORE_PUBLIC_KEY = test_YourTestStorePublicKey
