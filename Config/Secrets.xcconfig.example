// 1. Copy this file to Secrets.xcconfig (same folder).
// 2. Replace YOUR_PROJECT with your Supabase ref (subdomain before .supabase.co).
// Secrets.xcconfig is gitignored — never commit it.
//
// IMPORTANT: a raw `https://...` line is truncated at `//` (xcconfig comment).
// Use: https:/$()/$(/)YOUR_PROJECT.supabase.co
SUPABASE_URL = https:/$()/$(/)YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY = YOUR_SUPABASE_ANON_KEY
