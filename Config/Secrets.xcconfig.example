// 1. Copy this file to Secrets.xcconfig (same folder).
// 2. Replace YOUR_PROJECT with your Supabase ref (subdomain before .supabase.co).
// Secrets.xcconfig is gitignored — never commit it.
//
// IMPORTANT: a raw `https://...` line is truncated at `//` (xcconfig comment).
// Use: https:/$()/$(/)YOUR_PROJECT.supabase.co
SUPABASE_URL = https:/$()/$(/)YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY = YOUR_SUPABASE_ANON_KEY

// Optional — Meta App Events (public client values; copy from Meta Developers → Settings → Basic).
FACEBOOK_APP_ID = YOUR_FACEBOOK_APP_ID
FACEBOOK_CLIENT_TOKEN = YOUR_FACEBOOK_CLIENT_TOKEN

// Optional — Debug only. Copy to Secrets.xcconfig; never commit real keys.
// RevenueCat Test Store public SDK key (test_…). Release/TestFlight ignores this; use appl_… via Xcode target REVENUECAT_APP_STORE_PUBLIC_KEY for archives.
// REVENUECAT_TEST_STORE_PUBLIC_KEY = test_YourTestStorePublicKey
