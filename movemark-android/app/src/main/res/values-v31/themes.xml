<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ draws its own splash: the app icon on windowSplashScreenBackground (not windowBackground).
         The light page colour, as every screen (owner: one light system, 2026-11-18). -->
    <style name="Theme.MoveMark" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">#FFF8F8F8</item>
        <item name="android:navigationBarColor">#FFF8F8F8</item>
        <item name="android:windowBackground">#FFF8F8F8</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowSplashScreenBackground">#FFF8F8F8</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#FFF8F8F8</item>
    </style>
</resources>
