<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>MoveMark</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>movemark.auth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>movemark</string>
			</array>
		</dict>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>MoveMark uses the camera to capture move-in and move-out proof photos for your rental.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>MoveMark uses your photo library so you can attach existing evidence photos and supporting images to property records, maintenance logs, and exports.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>MoveMark may save exported or captured images to your photo library when you choose to do so.</string>
	<key>LegalPrivacyPolicyURL</key>
	<string>https://movemark.ca/privacy</string>
	<key>LegalTermsURL</key>
	<string>https://movemark.ca/terms</string>
	<key>LegalSupportURL</key>
	<string>https://movemark.ca/support</string>
	<key>LegalAccountDeletionURL</key>
	<string>https://movemark.ca/delete-account</string>
	<key>LegalSupportEmail</key>
	<string>connect@movemark.ca</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>RevenueCatPublicAPIKey</key>
	<string>$(REVENUECAT_APP_STORE_PUBLIC_KEY)</string>
	<key>RevenueCatTestStorePublicAPIKey</key>
	<string>$(REVENUECAT_TEST_STORE_PUBLIC_KEY)</string>
	<key>MoveMarkAPIBaseURL</key>
	<string>$(MoveMarkAPIBaseURL)</string>
	<key>MoveMarkAPIBaseURLOverride</key>
	<string>$(MOVEMARK_API_BASE_URL_OVERRIDE)</string>
	<key>NeonAuthURL</key>
	<string>$(NEON_AUTH_URL)</string>
	<key>NeonDataAPIURL</key>
	<string>$(NEON_DATA_API_URL)</string>
	<key>MoveMarkPasswordResetURL</key>
	<string>$(MOVEMARK_PASSWORD_RESET_URL)</string>
</dict>
</plist>
